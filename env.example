# Contact form email delivery
# Prefer Resend (https://resend.com) — or use SMTP below.

CONTACT_TO_EMAIL=info@xoomplus.co.uk
CONTACT_FROM_EMAIL="Xoomplus <onboarding@resend.dev>"

# Option A — Resend
RESEND_API_KEY=

# Option B — SMTP (e.g. hosting / Google Workspace / Microsoft 365)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
